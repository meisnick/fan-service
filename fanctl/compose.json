{
  "services": {
    "fanctl": {
      "image": "fanctl:1",
      "pull_policy": "never",
      "privileged": true,
      "restart": "unless-stopped",
      "stop_grace_period": "20s",
      "environment": {
        "TZ": "Etc/UTC",
        "PUID": "1004",
        "PGID": "3005",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "utility"
      },
      "ports": [
        "31090:8090"
      ],
      "volumes": [
        "/mnt/apps/fanctl/app:/app:ro",
        "/mnt/apps/fanctl/config:/config",
        "/mnt/apps/fanctl/logs:/logs"
      ],
      "runtime": "nvidia",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "3"
        }
      }
    }
  }
}
